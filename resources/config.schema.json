{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/hideutil/config.schema.json",
  "title": "HideUtil configuration",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "language": { "type": "string", "enum": ["auto", "en-US", "zh-CN"] },
    "hotkey": {
      "type": "object",
      "properties": {
        "hideToggle": { "$ref": "#/definitions/hotkeySpec" },
        "openSettings": { "$ref": "#/definitions/hotkeySpec" }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "requireElevation": { "type": "boolean" },
        "startHidden": { "type": "boolean" },
        "registerAutostart": { "type": "boolean" },
        "pollIntervalMs": { "type": "integer", "minimum": 100 }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "hotkeySpec": {
      "type": "object",
      "properties": {
        "modifiers": {
          "type": "array",
          "items": { "type": "string", "enum": ["CTRL", "ALT", "SHIFT", "WIN"] }
        },
        "key": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "match": {
          "type": "object",
          "properties": {
            "exePath": { "type": ["string", "null"] },
            "processName": { "type": ["string", "null"] },
            "windowClass": { "type": ["string", "null"] },
            "matchMode": { "type": "string", "enum": ["any", "all"] }
          }
        },
        "actions": {
          "type": "object",
          "properties": {
            "hideWindow": { "type": "boolean" },
            "hideTrayIcon": { "type": "boolean" },
            "muteAudio": { "type": "boolean" },
            "suspendProcess": { "type": "boolean" },
            "moveToVirtualDesktop": { "type": "boolean" },
            "hideFromAltTab": { "type": "boolean" },
            "clearJumpList": { "type": "boolean" }
          }
        },
        "restore": {
          "type": "object",
          "properties": {
            "restoreWindowPosition": { "type": "boolean" },
            "restoreForegroundWindow": { "type": "boolean" }
          }
        }
      }
    }
  }
}
